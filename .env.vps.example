NODE_ENV=production
PORT=3000

# Local SQLite/libSQL file used on the VPS.
DATABASE_URL=file:/var/lib/nhr-persi/nhr-persi.db

# Use one long random secret and keep it stable, otherwise users must log in again.
JWT_SECRET=replace-with-long-random-secret

# Admin fallback login.
ADMIN_EMAIL=adminpersi
ADMIN_PASSWORD=replace-with-admin-password

# Same-origin API on VPS, so leave empty.
VITE_API_BASE_URL=

# Production origin for CORS.
ALLOWED_ORIGIN=https://peringkatpersi.id

# Optional only during Turso migration or fallback.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
