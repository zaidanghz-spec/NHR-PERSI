# VPS/local SQLite database. Use this when running on Contabo/VPS.
DATABASE_URL=file:./data/nhr-persi.db

# Turso database. Optional fallback if still running against Turso.
TURSO_DATABASE_URL=libsql://your-db.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token

# REQUIRED — set a long random string in production (e.g. openssl rand -base64 48)
JWT_SECRET=your-long-random-secret-here

# Allowed CORS origin in production (e.g. https://your-domain.com). Omit or leave blank to allow all origins (local dev).
ALLOWED_ORIGIN=

# Frontend API base URL (leave empty in production if API is same-origin)
VITE_API_BASE_URL=

# Admin login fallback. Keep both values in Vercel Production env.
VITE_ADMIN_EMAIL=admin@persi
VITE_ADMIN_PASSWORD=change-me
